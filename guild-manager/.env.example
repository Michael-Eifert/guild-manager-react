# Copy this file to .env for local development. Never commit the resulting
# .env file. Vite embeds every VITE_* value in the public browser bundle, so
# these variables may contain public URLs only and must never contain secrets.
VITE_GEMINI_PROXY_URL=http://localhost:8787/api/gemini
VITE_AI_PROXY_URL=http://localhost:8788/api/chat

# Server-only Gemini proxy configuration. Leave the key empty until you enable
# the optional Oracle integration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PROXY_PORT=8787

# Server-only OpenAI-compatible proxy configuration. AI_BASE_URL is the
# provider endpoint; AI_API_KEY is read only by the proxy process.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_PROXY_PORT=8788

# Shared proxy hardening. Production must use NODE_ENV=production and list
# every allowed browser origin explicitly, separated by commas.
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
MAX_CONCURRENT_REQUESTS=6

# Optional Gemini proxy controls.
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_MINUTE=10
TRUST_PROXY=false
