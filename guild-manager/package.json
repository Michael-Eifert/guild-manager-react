{
  "name": "guild-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:items": "tsx scripts/generate-item-catalog.ts",
    "sync:item-icons": "tsx scripts/sync-item-icons.ts",
    "predev": "npm run generate:items",
    "dev": "vite",
    "prebuild": "npm run generate:items",
    "build": "vite build && tsx scripts/create-spa-404.ts",
    "lint": "eslint .",
    "typecheck": "npm run typecheck:app && npm run typecheck:test && npm run typecheck:node",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:extended": "tsc --noEmit -p tsconfig.extended.json",
    "migration:check": "tsx scripts/check-typescript-migration.ts",
    "bundle:check": "tsx scripts/check-bundle-size.ts",
    "check": "npm run migration:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run bundle:check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:soak": "vitest run --config vitest.soak.config.ts",
    "test:extended": "npm run typecheck:extended && npm run test:soak && npm run test:e2e",
    "proxy:ai": "tsx server/ai-proxy.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/lato": "^5.2.7",
    "lucide-react": "^0.564.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.15.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.5"
  }
}
